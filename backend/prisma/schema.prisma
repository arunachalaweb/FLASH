generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model ContactEnquiry {
  id          String   @id @default(uuid())
  name        String
  email       String
  phone       String?
  subject     String?
  message     String
  status      String   @default("new")
  admin_notes       String?
  assigned_staff_id String?
  created_at        DateTime @default(now())
  updated_at        DateTime? @updatedAt
}

model NewsletterSubscriber {
  id         String   @id @default(uuid())
  email      String   @unique
  active     Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime? @updatedAt
}

model QuoteRequest {
  id            String   @id @default(uuid())
  name          String
  email         String
  phone         String?
  city          String?
  budget        String?
  load_kw       String?
  message       String?
  property_type String?
  service_type  String?
  status        String   @default("new")
  admin_notes       String?
  assigned_staff_id String?
  created_at        DateTime @default(now())
  updated_at        DateTime? @updatedAt
}

model AdminUser {
  id          String   @id @default(uuid())
  username    String   @unique
  password    String
  full_name   String?
  email       String?
  phone       String?
  role        String   @default("admin")
  active      Boolean  @default(true)
  created_at  DateTime @default(now())
}

model UserRole {
  id         String   @id @default(uuid())
  user_id    String
  role       String
  created_at DateTime @default(now())
}

model Project {
  id                        String   @id @default(uuid())
  title                     String
  slug                      String?
  sector                    String?
  location                  String?
  capacity                  String?
  completion_date           String?
  description               String?
  featured_image            String?
  gallery_images            String?
  sort_order                Int      @default(0)
  published                 Boolean  @default(false)
  assigned_staff_id         String?
  status                    String   @default("pending")
  progress_percent          Int      @default(0)
  installation_instructions String?
  created_at                DateTime @default(now())
  updated_at                DateTime? @updatedAt
}

model Service {
  id                String   @id @default(uuid())
  title             String
  slug              String   @unique
  icon_name         String?
  short_description String?
  long_description  String?
  featured_image    String?
  gallery_images    String?
  benefits          String?
  sort_order        Int      @default(0)
  published         Boolean  @default(false)
  created_at        DateTime @default(now())
  updated_at        DateTime? @updatedAt
}

model TeamMember {
  id           String   @id @default(uuid())
  name         String
  role         String?
  system_role  String   @default("staff")
  email        String?
  phone        String?
  linkedin_url String?
  photo_url    String?
  bio          String?
  sort_order   Int      @default(0)
  published    Boolean  @default(false)
  username     String?  @unique
  password     String?
  education    String?
  experience   String?
  domain_core  String?
  address      String?
  dob          String?
  joining_date String?
  created_at   DateTime @default(now())
  updated_at   DateTime? @updatedAt
}

model Testimonial {
  id           String   @id @default(uuid())
  author_name  String
  author_role  String?
  author_image String?
  quote        String
  rating       Int      @default(5)
  published    Boolean  @default(false)
  sort_order   Int      @default(0)
  created_at   DateTime @default(now())
  updated_at   DateTime? @updatedAt
}

model Faq {
  id         String   @id @default(uuid())
  question   String
  answer     String
  category   String?
  published  Boolean  @default(false)
  sort_order Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime? @updatedAt
}

model PageContent {
  id          String   @id @default(uuid())
  page_slug   String
  section_key String
  title       String?
  subtitle    String?
  body        String?
  image_url   String?
  created_at  DateTime @default(now())
  updated_at  DateTime? @updatedAt

  @@unique([page_slug, section_key])
}

model Profile {
  id         String   @id @default(uuid())
  full_name  String?
  email      String?
  phone      String?
  created_at DateTime @default(now())
  updated_at DateTime? @updatedAt
}

model SystemSetting {
  id         String   @id @default(uuid())
  key        String   @unique
  value      String
  created_at DateTime @default(now())
  updated_at DateTime? @updatedAt
}

model StaffMessage {
  id           String   @id @default(uuid())
  project_id   String?
  sender_role  String
  sender_name  String
  recipient_id String
  message      String
  created_at   DateTime @default(now())
}

model HeroSlide {
  id          String   @id @default(uuid())
  page_slug   String   @default("home")
  title       String?
  subtitle    String?
  image_url   String
  button_text String?
  button_link String?
  sort_order  Int      @default(0)
  created_at  DateTime @default(now())
  updated_at  DateTime? @updatedAt
}

model InvestorEnquiry {
  id                String    @id @default(uuid())
  name              String
  email             String
  phone             String
  organisation      String?
  investment_range  String
  investment_type   String
  timeline          String?
  message           String?
  status            String    @default("new")
  admin_notes       String?
  assigned_staff_id String?
  created_at        DateTime  @default(now())
  updated_at        DateTime? @updatedAt
}

model ChannelPartnerApplication {
  id            String    @id @default(uuid())
  name          String
  email         String
  phone         String
  business_name String
  business_type String
  partner_type  String
  state         String
  district      String
  experience    String?
  message       String?
  status        String    @default("new")
  admin_notes   String?
  assigned_staff_id String?
  created_at    DateTime  @default(now())
  updated_at    DateTime? @updatedAt
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  products    Product[]
  created_at  DateTime  @default(now())
  updated_at  DateTime? @updatedAt
}

model Brand {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  logo_url    String?
  description String?
  products    Product[]
  created_at  DateTime  @default(now())
  updated_at  DateTime? @updatedAt
}

model Product {
  id               String             @id @default(uuid())
  name             String
  slug             String             @unique
  description      String?
  price            Float
  sale_price       Float?
  sku              String?            @unique
  stock_quantity   Int                @default(0)
  manage_stock     Boolean            @default(true)
  images           String?            // JSON array of strings
  published        Boolean            @default(true)
  category_id      String?
  category         Category?          @relation(fields: [category_id], references: [id])
  brand_id         String?
  brand            Brand?             @relation(fields: [brand_id], references: [id])
  order_items      OrderItem[]
  package_items    SolarPackageItem[]
  
  // Solar Specifications
  datasheet_url    String?
  video_url        String?
  weight           Float?             // Weight in kg (for shipping calculation)
  watt_capacity    Int?               // e.g. 550 for panels
  voltage          String?            // e.g. 12V, 24V, 48V, 230V
  phase            String?            // e.g. single-phase, three-phase
  battery_capacity String?            // e.g. 150Ah, 200Ah
  panel_technology String?            // e.g. TOPCon, PERC
  cell_type        String?            // e.g. Monocrystalline, Polycrystalline

  created_at       DateTime           @default(now())
  updated_at       DateTime?          @updatedAt
}

model SolarPackage {
  id            String             @id @default(uuid())
  name          String
  slug          String             @unique
  description   String?
  price         Float
  image_url     String?
  features      String?            // JSON string array
  package_items SolarPackageItem[]
  enquiries     SolarEnquiry[]
  created_at    DateTime           @default(now())
  updated_at    DateTime?          @updatedAt
}

model SolarPackageItem {
  id          String       @id @default(uuid())
  package_id  String
  package     SolarPackage @relation(fields: [package_id], references: [id], onDelete: Cascade)
  product_id  String?
  product     Product?     @relation(fields: [product_id], references: [id], onDelete: SetNull)
  quantity    Int
  created_at  DateTime     @default(now())
}

model Customer {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  name          String
  phone         String?
  address_line1 String?
  address_line2 String?
  city          String?
  state         String?
  postal_code   String?
  orders        Order[]
  enquiries     SolarEnquiry[]
  created_at    DateTime  @default(now())
  updated_at    DateTime? @updatedAt
}

model Order {
  id                   String       @id @default(uuid())
  order_number         String       @unique
  customer_id          String?
  customer             Customer?    @relation(fields: [customer_id], references: [id])
  status               String       @default("pending") // pending, processing, completed, cancelled, refunded
  total_amount         Float
  shipping_name        String
  shipping_phone       String?
  shipping_address     String
  shipping_city        String
  shipping_state       String
  shipping_postal_code String
  payment_method       String       @default("cod")
  payment_status       String       @default("pending")
  order_items          OrderItem[]
  invoices             Invoice[]
  credit_notes         CreditNote[]
  quotation_id         String?
  created_at           DateTime     @default(now())
  updated_at           DateTime?    @updatedAt
}

model OrderItem {
  id         String   @id @default(uuid())
  order_id   String
  order      Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product_id String?
  product    Product? @relation(fields: [product_id], references: [id], onDelete: SetNull)
  quantity   Int
  price      Float
  total      Float
}

model Invoice {
  id             String    @id @default(uuid())
  invoice_number String    @unique
  order_id       String
  order          Order     @relation(fields: [order_id], references: [id])
  amount         Float
  status         String    @default("issued") // issued, paid, voided
  created_at     DateTime  @default(now())
  updated_at     DateTime? @updatedAt
}

model CreditNote {
  id                 String    @id @default(uuid())
  credit_note_number String    @unique
  order_id           String
  order              Order     @relation(fields: [order_id], references: [id])
  amount             Float
  reason             String?
  created_at         DateTime  @default(now())
  updated_at         DateTime? @updatedAt
}

model SolarEnquiry {
  id                 String        @id @default(uuid())
  customer_id        String?
  customer           Customer?     @relation(fields: [customer_id], references: [id])
  name               String
  email              String
  phone              String
  location           String
  required_capacity  String?       // e.g. 3kW, 5kW
  usage_type         String        @default("residential") // residential, commercial, agricultural
  monthly_bill       String?
  roof_type          String?
  installation_req   Boolean       @default(true)
  message            String?
  file_url           String?
  status             String        @default("pending") // pending, quoted, ordered, closed
  package_id         String?
  package            SolarPackage? @relation(fields: [package_id], references: [id])
  quotations         Quotation[]
  created_at         DateTime      @default(now())
  updated_at         DateTime?     @updatedAt
}

model Quotation {
  id               String       @id @default(uuid())
  quotation_number String       @unique
  enquiry_id       String?
  enquiry          SolarEnquiry? @relation(fields: [enquiry_id], references: [id])
  customer_name    String
  customer_email   String
  customer_phone   String?
  items            String       // JSON string array of items: { name, quantity, price, total }
  total_amount     Float
  status           String       @default("draft") // draft, sent, accepted, declined
  valid_until      DateTime?
  created_at       DateTime     @default(now())
  updated_at       DateTime?    @updatedAt
}

model Coupon {
  id             String    @id @default(uuid())
  code           String    @unique
  discount_type  String    @default("fixed") // fixed, percentage
  discount_value Float
  min_order_val  Float     @default(0)
  active         Boolean   @default(true)
  expires_at     DateTime?
  created_at     DateTime  @default(now())
}

model ShippingZone {
  id          String   @id @default(uuid())
  pincode     String   @unique
  base_charge Float    @default(0)
  per_kg_rate Float    @default(0)
  available   Boolean  @default(true)
  created_at  DateTime @default(now())
}
